# Application
NODE_ENV=development
PORT=3333

# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/wallet?schema=public"

# JWT (Chaves RSA utilizadas no Guard de Autenticação)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."

# SMTP / Email Service (para recuperação de passe e MFA)

RESEND_FROM_EMAIL=
RESEND_API_KEY=
