generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Mude para o seu banco (mysql, sqlite, etc)
}

model User {
  id                  String               @id @db.Uuid()
  email               String               @unique @db.VarChar(255)
  status              String               @db.VarChar()
  last_login_at       DateTime?
  created_at          DateTime
  updated_at          DateTime
  name                String               @db.VarChar(150)
  password_hash       String               @db.VarChar(255)
  mfa_required        Boolean
  document            String               @unique() @db.VarChar(30)
  mfaCodes            MfaCode[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  wallet              Wallet?
}

model MfaCode {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  code       String   @db.VarChar(255)
  type       String   @db.VarChar(255)
  expires_at DateTime
  used_at    Boolean
  attempts   Int
  created_at DateTime
  updated_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model PasswordResetToken {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(255)
  expires_at DateTime
  used_at    Boolean
  created_at DateTime
  updated_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model RefreshToken {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(255)
  revoked_at Boolean
  expires_at DateTime
  created_at DateTime
  updated_at DateTime
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model Wallet {
  id                    String        @id @db.Uuid
  user_id               String        @unique @db.Uuid // Adicionado @unique para garantir a relação 1:1
  user                  User          @relation(fields: [user_id], references: [id])
  balance               Decimal       @db.Decimal(10, 2)
  created_at            DateTime
  updated_at            DateTime
  sent_transactions     Transaction[] @relation("SenderWallet")
  received_transactions Transaction[] @relation("ReceiverWallet")
}

model Transaction {
  id                 String   @id @db.Uuid
  sender_wallet_id   String   @db.Uuid
  receiver_wallet_id String   @db.Uuid
  amount             Decimal  @db.Decimal(10, 2)
  status             String
  created_at         DateTime
  updated_at         DateTime
  sender_wallet      Wallet   @relation("SenderWallet", fields: [sender_wallet_id], references: [id])
  receiver_wallet    Wallet   @relation("ReceiverWallet", fields: [receiver_wallet_id], references: [id])
}
